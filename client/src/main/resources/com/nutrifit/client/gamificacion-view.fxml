<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nutrifit.client.controller.GamificacionController"
            style="-fx-background-color: linear-gradient(to right, #0f172a, #111827);">

    <top>
        <VBox spacing="4" style="-fx-padding: 20 20 10 20;">
            <Label text="NutriFit"
                   style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Label text="Tu progreso de gamificación"
                   style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="24" style="-fx-padding: 24;">

            <HBox spacing="12">
                <Button text="Volver"
                        onAction="#onVolver"
                        style="-fx-background-color: #475569; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 16;"/>
            </HBox>

            <GridPane hgap="24" vgap="20">
                <padding><Insets top="6" right="6" bottom="6" left="6"/></padding>

                <Label text="Racha (días)"
                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px;"
                       GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="rachaLabel" text="0"
                       style="-fx-text-fill: #86efac; -fx-font-size: 20px; -fx-font-weight: bold;"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Puntuación"
                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px;"
                       GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="nutriScoreLabel" text="0"
                       style="-fx-text-fill: #93c5fd; -fx-font-size: 20px; -fx-font-weight: bold;"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Nivel"
                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px;"
                       GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="nutriGradeLabel" text="—"
                       style="-fx-text-fill: #f9a8d4; -fx-font-size: 20px; -fx-font-weight: bold;"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Proteína"
                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px;"
                       GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Label fx:id="cumpleProteinaLabel" text="—"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-font-weight: bold;"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Balance calórico"
                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px;"
                       GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <Label fx:id="cumpleBalanceLabel" text="—"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-font-weight: bold;"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Ejercicio"
                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px;"
                       GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <Label fx:id="cumpleEjercicioLabel" text="—"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-font-weight: bold;"
                       GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Variedad"
                       style="-fx-text-fill: #e5e7eb; -fx-font-size: 15px;"
                       GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <Label fx:id="cumpleVariedadLabel" text="—"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 16px; -fx-font-weight: bold;"
                       GridPane.rowIndex="6" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="statusLabel"
               text="Cargando gamificación..."
               maxWidth="Infinity"
               style="-fx-background-color: #020617; -fx-text-fill: #93c5fd; -fx-padding: 12; -fx-font-size: 13px;"/>
    </bottom>
</BorderPane>

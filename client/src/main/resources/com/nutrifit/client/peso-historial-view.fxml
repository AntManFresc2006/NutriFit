<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nutrifit.client.controller.PesoHistorialController"
            style="-fx-background-color: linear-gradient(to right, #0f172a, #111827);">

    <top>
        <VBox spacing="4" style="-fx-padding: 20 20 10 20;">
            <Label text="NutriFit"
                   style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>
            <Label text="Historial de peso"
                   style="-fx-text-fill: #cbd5e1; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="16" style="-fx-padding: 24;">

            <HBox spacing="12">
                <Button text="Volver"
                        onAction="#onVolver"
                        style="-fx-background-color: #475569; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 16;"/>
            </HBox>

            <VBox spacing="12" style="-fx-border-color: #334155; -fx-border-radius: 8; -fx-padding: 16; -fx-background-color: #1e293b; -fx-background-radius: 8;">
                <Label text="Registrar nuevo peso"
                       style="-fx-text-fill: #cbd5e1; -fx-font-size: 15px; -fx-font-weight: bold;"/>

                <GridPane hgap="12" vgap="12">
                    <Label text="Fecha"
                           style="-fx-text-fill: #e5e7eb; -fx-font-size: 14px;"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="fechaPicker"
                                GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Peso (kg)"
                           style="-fx-text-fill: #e5e7eb; -fx-font-size: 14px;"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="pesoField" promptText="70.0"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                </GridPane>

                <Button text="Registrar"
                        onAction="#onRegistrarPeso"
                        maxWidth="Infinity"
                        style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 10 16;"/>
            </VBox>

            <Label text="Últimos registros"
                   style="-fx-text-fill: #cbd5e1; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <TableView fx:id="pesoTable" VBox.vgrow="ALWAYS"
                       style="-fx-background-color: #1e293b; -fx-border-color: #334155; -fx-border-radius: 8;">
                <columns>
                    <TableColumn text="Fecha" prefWidth="150.0">
                        <cellValueFactory>
                            <PropertyValueFactory property="fecha"/>
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Peso (kg)" prefWidth="150.0">
                        <cellValueFactory>
                            <PropertyValueFactory property="pesoKg"/>
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <Label fx:id="statusLabel"
               text="Cargando historial..."
               maxWidth="Infinity"
               style="-fx-background-color: #020617; -fx-text-fill: #93c5fd; -fx-padding: 12; -fx-font-size: 13px;"/>
    </bottom>
</BorderPane>
